{
    "compilerOptions": {
        "target": "ES2020",
        "module": "Node16",
        "moduleResolution": "Node16",
        "rootDir": ".",
        "outDir": "./dist",
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "isolatedModules": true,
        "types": ["node", "jest"]
    },
    "include": ["src/**/*", "test/**/*"],
    "exclude": ["node_modules"]
}
